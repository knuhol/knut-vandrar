# VPS development settings; copy to /etc/knut-vandrar/development.env and replace the password.
# Docker image and build configuration. Runtime language versions come only from
# .nvmrc and .python-version; scripts/compose.sh passes those to the builds.
DOCKER_TARGET=production

# PostgreSQL credentials. Replace the local-only password before VPS use.
POSTGRES_DATABASE=knut_vandrar_dev
POSTGRES_USER=knut_vandrar_dev
POSTGRES_PASSWORD=replace-with-a-unique-long-random-password
POSTGRES_PORT=5433
POSTGRES_INTERNAL_PORT=5432
DATABASE_SERVICE_HOST=postgres

# Host-published local app ports and container listener ports.
BACKEND_PORT=8000
FRONTEND_PORT=3000
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_INTERNAL_PORT=3000
FRONTEND_HOST=0.0.0.0

# Canonical website origin for metadata and discovery (server-only).
SITE_URL=https://dev.vandrar.se

# Browser URL and allowed browser origin.
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DATABASE}
NEXT_PUBLIC_API_URL=https://dev.vandrar.se
CORS_ORIGINS=https://dev.vandrar.se

# OpenAI API key for automatic backend translations; set only in local/private env files.
OPENAI_REQUEST_TIMEOUT_SECONDS=600
OPENAI_API_KEY=replace-with-openai-api-key

# Host-run frontend only; Compose supplies the Docker-internal API URL.
INTERNAL_API_URL=http://backend:${API_PORT}

# Server-only API write token; empty disables writes. Generate a random
# URL-safe value (43–128 characters), independently for each environment.
API_WRITE_TOKEN=

# Private dev preview (server only; used exclusively on dev.vandrar.se).
# Generate with frontend/scripts/admin-password.mjs <output-file> --dev-gate.
DEV_GATE_PASSWORD_HASH=

# Admin login (server only). Generate the password hash using frontend/scripts/admin-password.mjs.
ADMIN_PASSWORD_HASH=
# Exact browser origin; HTTPS required in production.
ADMIN_ORIGIN=https://dev.vandrar.se

# Admin environment label; VPS routing overrides set dev/prod automatically.
DEPLOYMENT_ENVIRONMENT=dev

# Host development image storage; Docker uses its dedicated /media volume.
MEDIA_ROOT=/media

# Optional workstation SSH transport for media commands and DB backup/restore.
# Set this in workstation copies; leave it empty in the VPS environment file.
MEDIA_SSH_HOST=
# Parent directory containing the VPS dev/ and prod/ repository checkouts.
MEDIA_REMOTE_CHECKOUTS_DIR=/srv/knut-vandrar

# Public Umami tracker settings; collection is enabled only in prod.
UMAMI_SCRIPT_URL=https://umami.vandrar.se/script.js
UMAMI_WEBSITE_ID=

# Backend-only Garmin MapShare integration
GARMIN_MAPSHARE_USERNAME=knuhol
GARMIN_POLL_SECONDS=120
