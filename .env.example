# Docker image and build configuration. Runtime language versions come only from
# .nvmrc and .python-version; scripts/compose.sh passes those to the builds.
DOCKER_TARGET=development

# PostgreSQL credentials. Replace the local-only password before VPS use.
POSTGRES_DATABASE=knut_vandrar
POSTGRES_USER=knut
POSTGRES_PASSWORD=change-this-local-only-password
POSTGRES_PORT=5432
POSTGRES_INTERNAL_PORT=5432
DATABASE_SERVICE_HOST=postgres

# Host-published local app ports and container listener ports.
BACKEND_PORT=8000
FRONTEND_PORT=3000
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_INTERNAL_PORT=3000
FRONTEND_HOST=0.0.0.0

# Browser URL and allowed browser origin.
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DATABASE}
NEXT_PUBLIC_API_URL=http://localhost:${BACKEND_PORT}
CORS_ORIGINS=http://localhost:${FRONTEND_PORT}

# OpenAI API key for automatic backend translations; set only in local/private env files.
OPENAI_REQUEST_TIMEOUT_SECONDS=600
OPENAI_API_KEY=

# Host-run frontend only; Compose supplies the Docker-internal API URL.
INTERNAL_API_URL=http://localhost:${API_PORT}

# Server-only API write token. Leave empty to disable writes; set a random
# URL-safe token (43–128 characters) to enable Bearer authentication.
API_WRITE_TOKEN=

# Admin login (server only). Generate the password hash using frontend/scripts/admin-password.mjs.
ADMIN_PASSWORD_HASH=
# Exact browser origin; HTTPS required in production.
ADMIN_ORIGIN=http://localhost:3000

# Admin environment label; VPS routing overrides set dev/prod automatically.
DEPLOYMENT_ENVIRONMENT=local

# Host development image storage; Docker uses its dedicated /media volume.
MEDIA_ROOT=./backend/.media
