# PostgreSQL credentials used by the Compose database and backend container.
# Replace the local-only password before using this outside local development.
POSTGRES_DATABASE=knut_vandrar
POSTGRES_USER=knut
POSTGRES_PASSWORD=change-this-local-only-password

# PostgreSQL internal port and host-published port.
POSTGRES_PORT=5432
POSTGRES_INTERNAL_PORT=5432

# Compose service DNS name used by the backend container.
DATABASE_SERVICE_HOST=postgres

# Host-published application ports.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend listen address and internal port.
API_HOST=0.0.0.0
API_PORT=8000

# Frontend internal listen port.
FRONTEND_INTERNAL_PORT=3000
FRONTEND_HOST=0.0.0.0
WATCHPACK_POLLING=true

# Local backend URL supplies the host/driver. Database name and credentials
# always come from the POSTGRES_* settings above. Compose uses the service host.
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DATABASE}

# Public browser API base URL. NEXT_PUBLIC values must never contain secrets.
NEXT_PUBLIC_API_URL=http://localhost:${BACKEND_PORT}

# Browser origins allowed by FastAPI, and optional SQLAlchemy query logging.
CORS_ORIGINS=http://localhost:${FRONTEND_PORT}
SQLALCHEMY_ECHO=false
