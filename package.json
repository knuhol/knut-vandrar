{
  "name": "knut-vandrar",
  "version": "1.0.0",
  "private": true,
  "description": "Knut vandrar - Full-stack travel companion monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "./scripts/compose.sh up --build",
    "build": "./scripts/compose.sh build",
    "start": "./scripts/compose.sh up -d",
    "stop": "./scripts/compose.sh down",
    "fresh": "./scripts/compose.sh down -v && ./scripts/compose.sh up --build",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && pip install -r requirements.txt",
    "translations:retranslate": "./scripts/compose.sh exec -T backend python -m knut_vandrar_backend.translations.cli"
  },
  "keywords": [
    "travel",
    "nextjs",
    "fastapi",
    "postgresql"
  ],
  "author": "",
  "license": "MIT"
}
